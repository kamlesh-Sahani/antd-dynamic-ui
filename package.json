{
  "name": "antd-dynamic-ui",
  "version": "1.0.0",
  "description": "A high-productivity UI toolkit for React and Ant Design featuring schema-driven DynamicForm, DynamicTable, and 25+ standardized form fields.",
  "author": "Kamlesh Sahani",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.cjs",
    "dev": "tsup --config tsup.config.cjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "react",
    "antd",
    "ant-design",
    "dynamic-form",
    "dynamic-table",
    "form-builder",
    "json-schema",
    "table",
    "zod",
    "react-hook-form",
    "velocity-http",
    "ui-components"
  ],
  "peerDependencies": {
    "antd": "^5.0.0 || ^6.0.0",
    "dayjs": "^1.11.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.0.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1 || ^6.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.0 || ^4.0.0 || ^5.0.0",
    "@types/file-saver": "^2.0.7",
    "chart.js": "^4.5.1",
    "classnames": "^2.5.1",
    "file-saver": "^2.0.5",
    "headless-countries": "^1.0.0",
    "jszip": "^3.10.2",
    "react-chartjs-2": "^5.3.1",
    "react-icons": "^5.5.0",
    "react-modal": "^3.16.3",
    "react-zoom-pan-pinch": "^4.2.0",
    "velocity-http": "^2.0.2",
    "xlsx-js-style": "^1.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-modal": "^3.16.3",
    "postcss": "^8.4.49",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0"
  }
}
